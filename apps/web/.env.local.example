# Gerçek bir Supabase projesi bağlanana kadar true bırak — repository'ler
# ve auth akışı @hemdem/core/infrastructure/mock içindeki zengin seed
# veriyle çalışır (bkz. PLAN.md). Gerçek Supabase'e geçince false yap.
NEXT_PUBLIC_USE_MOCK_DATA=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Vercel Cron uçlarını (leaderboard-rewards, daily-match — bkz. vercel.json)
# dışarıdan keyfi çağrılmaya karşı korur. Vercel projesinin Settings →
# Environment Variables kısmında ayarlanmalı; boş bırakılırsa cron uçları
# kimlik doğrulaması OLMADAN herkese açık kalır (bkz. route.js'lerdeki
# "cronSecret varsa kontrol et" mantığı) — production'da mutlaka doldur.
CRON_SECRET=
