{
  "expo": {
    "name": "Hemdem",
    "slug": "hemdem",
    "scheme": "hemdem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121014"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmek için fotoğraflarına erişim izni gerekiyor."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.hemdem.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçebilmek için fotoğraflarına erişim izni gerekiyor."
      }
    },
    "android": {
      "package": "com.hemdem.mobile",
      "permissions": ["READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5e898823-8c6e-437f-ae8f-9b5fcf1f92e1"
      }
    }
  }
}
