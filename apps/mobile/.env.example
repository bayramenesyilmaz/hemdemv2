# Yerel geliştirme için bu dosyayı .env olarak kopyala (.env kök
# .gitignore'da genel bir kural olarak yok sayılıyor — EAS build'leri
# eas.json'daki "env" bloklarından kendi değerini zaten alıyor, bu dosya
# sadece `pnpm --filter @hemdem/mobile start` ile yerel geliştirme için).
#
# EXPO_PUBLIC_* değişkenleri build zamanında client bundle'ına gömülür,
# gizli değildir.
EXPO_PUBLIC_WEB_BASE_URL=https://hemdemv2-web.vercel.app
